<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console logging with trace correlation.

  The OpenTelemetry Java agent (auto-instrumentation) injects the MDC keys
  `trace_id`, `span_id` and `trace_flags` for every log statement emitted inside an
  active span (OTEL_INSTRUMENTATION_LOGBACK_MDC_ENABLED defaults to true). Printing them
  here lets Grafana correlate a Loki log line with the matching Tempo trace.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} trace_id=%X{trace_id:-} span_id=%X{span_id:-} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
